# Copy to .env and adjust for the docker-compose stack.
#   cp .env.example .env
# Compose reads this file automatically (you can also export the values in the
# shell). docker-compose.yml has no fallback for either of them, so the stack
# fails fast when one is missing.

# Shared internal token for the bus (HTTP and WebSocket). Every component of the
# stack holds the same value, and so does every agent container the runner
# provisions. Generate one, e.g. `openssl rand -hex 24`.
NANOSEC_BUS_INTERNAL_TOKEN=change-me

# The one database the platform uses. Every module writes its own prefix inside
# it (auth_, admin_, portal_, bus_, provisioner_, sys_, artifacts_); nobody
# writes another module's prefix, and cross-module reads go over HTTP.
NANOSEC_BUS_DATABASE_URI=mongodb://nanosec:change-me@db.example.com:27017/nanosec?authSource=admin

# The work library (nanoartifacts) uses the same database, under artifacts_
# (its root collection is `artifacts`). Point this at the same URI as above;
# with a dedicated user, grant it a role scoped to the artifacts collections.
NANOARTIFACTS_MONGO_URI=mongodb://nanosec:change-me@db.example.com:27017/nanosec?authSource=admin

# HMAC key for the preview-session cookie. The SPA exchanges the user's JWT for
# this cookie (HttpOnly, scoped to /nanoartifacts/api), so the frame can load a
# document without a URL that expires mid-view. Generate one:
#   openssl rand -hex 32
NANOARTIFACTS_SESSION_SECRET=change-me

# Optional: scope of the preview cookie (default "/"). Tighten it to
# /nanoartifacts/api if you want it confined to the library's API; a path that does
# not match what the browser requests makes every preview return 401.
# NANOARTIFACTS_COOKIE_PATH=/nanoartifacts/api

# Per-user storage ceiling in bytes (default 2 GiB). Counted after content
# dedupe: the same bytes published twice cost once.
NANOARTIFACTS_QUOTA_BYTES=2147483648
