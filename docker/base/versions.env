# Version matrix for the NanoSec base images.
#
# This file is the single place a toolchain version is written down. The
# Dockerfiles in this directory carry the same values as ARG defaults (so a
# plain `docker build -f docker/base/<name>.Dockerfile docker/base` works), and
# scripts/base/build-base-images.sh reads this file to tag and build them.
#
# Rules:
#   * tags are immutable: bump BASE_REV when anything here changes
#   * no `latest`: services pin the full tag in their Dockerfile
#   * a base image is rebuilt only by the Ops.BaseImages job, never ad hoc
#
# Go: the two most recent releases are supported (go.dev/dl lists exactly
#   1.27.4 and 1.26.11 as of 2026-11-21), so 1.25 is out of support. 1.27.4 is
#   also the version the agent runtime ships, which keeps one Go everywhere.
# Node: v26 became the Active LTS on 2026-10-28 (nodejs/Release schedule.json),
#   supported until 2029-04-30. v24 is the previous LTS (until 2028-04-30).
# Alpine: 3.24 is the current stable branch.

GO_VERSION=1.27.4
GO_ALPINE=3.24

RUNTIME_ALPINE=3.24.4

NODE_VERSION=26.13.1
NODE_ALPINE=3.24

# Bumped whenever any of the above (or the contents of a Dockerfile here)
# changes. Never reuse a revision for different content.
BASE_REV=r2

# The agent runtime tag. The versions themselves live in
# nanoagent/runtime-base/Dockerfile (it is an application runtime, not a
# builder); the tag is repeated here so one job builds all four base images.
AGENT_RUNTIME_TAG=24.04-node26.13.1-go1.27.4-r2
