# 旧栈 → staging 迁移的全部可调项。复制成 cutover.env（0600），只改这里。
# 下面前缀是唯一决定 staging 所有 Docker 名字的变量：
#   ENV_PREFIX=stg-  → 项目 stg-nanosec、网络 stg-nanosec_default、
#                      agent 容器 stg-nanosec-agent-<id>、卷 stg-nanosec-data-<id>
ENV_PREFIX=stg-

# 旧栈（生产，迁移源）
OLD_PROJECT=devmyriadmind
OLD_DB=nanobus
# 旧作品库在同一个 Mongo 实例上的独立库（旧栈的 NANOARTIFACTS_MONGO_URI）
OLD_ARTIFACTS_DB=nanoartifacts
# 旧 compose 只在停止旧栈时用到；留空则按 project 停。
OLD_COMPOSE=

# staging（迁移目标）。宿主目录由 stage-init 创建。
NEW_ROOT=/home/kobeyoung81/nanosec-stg
NEW_ENV=$NEW_ROOT/stg.env

# 库名：ENV_PREFIX 的 '-' 换成 '_' 再拼 nanosec
NEW_DB=stg_nanosec
# 演练目标库与卷前缀（rehearse 用，cleanup 会删）
TEST_DB=nanosec_cutover_test
TEST_VOLUME_PREFIX=migtest-

# Mongo
MONGO_IMAGE=mongo:8.2.6
STATE=/home/kobeyoung81/nanosec-cutover
ROOT_ENV=/home/kobeyoung81/nanosec-mongo/p1-root.env

# 卷前缀（旧栈没有前缀；staging 用 ENV_PREFIX）
OLD_VOLUME_PREFIX=
NEW_VOLUME_PREFIX=$ENV_PREFIX
