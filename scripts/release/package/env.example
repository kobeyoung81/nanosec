# Copy to .env and fill in. The compose file refuses to start without the first
# two values, so a missing one fails fast instead of silently using a default.

# Shared internal token: the bus's internal surfaces, and every agent container
# the runner provisions, hold this same value. Generate: openssl rand -hex 24
NANOSEC_BUS_INTERNAL_TOKEN=

# The one database, name `nanosec`. Every module writes its own prefix inside it.
# Use the host's LAN IP, not a *.home name: inside a container that resolves to
# 127.0.0.1. Shape:
#   mongodb://<user>:<password>@<host-lan-ip>:27017/nanosec?authSource=admin
NANOSEC_BUS_DATABASE_URI=

# HMAC key for the work library's preview cookie. Generate: openssl rand -hex 32
NANOARTIFACTS_SESSION_SECRET=

# Per-stack naming. Empty for a single stack; `stg-` or `dev-` for another one
# beside it (project, network, agent containers and volumes all follow it).
ENV_PREFIX=
