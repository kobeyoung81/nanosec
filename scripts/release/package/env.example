# MyriadMind 部署环境变量（复制为 compose/.env 后填写）
# docker-compose.yml 对这两项都是 ${VAR:?} 强依赖：缺任何一个，栈都会拒绝启动。

# 共享内部令牌：全栈一致（bus 的 REST/隧道/终端、以及 runner 开的 agent 容器都用它）。
# 生成：openssl rand -hex 24
NANOSEC_BUS_INTERNAL_TOKEN=

# 外置 MongoDB（库名必须是 nanobus；只有 nanobus 连接它）。
# **务必用宿主 LAN IP，不要用 *.home 主机名** —— compose 网络内 *.home 会被解析到 127.0.0.1。
# 形如：mongodb://<user>:<password>@<host-lan-ip>:27017/nanobus?authSource=admin
NANOSEC_BUS_DATABASE_URI=
